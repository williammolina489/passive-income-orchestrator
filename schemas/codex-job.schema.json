{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/williammolina489/passive-income-orchestrator/blob/main/schemas/codex-job.schema.json",
  "title": "Passive Income Orchestrator Codex PR Job",
  "description": "A PR-only repository editing job. Execution is additionally gated by projects.yaml code_worker configuration and a separate write token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "expected_head_sha",
    "authorization_basis",
    "objective",
    "constraints",
    "allowed_paths",
    "forbidden_actions",
    "completion_criteria",
    "methodology_change_permitted",
    "protected_data_permissions",
    "financial_permissions",
    "merge_to_default_branch_permitted"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "expected_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "methodology_change_permitted": {
      "const": false
    },
    "protected_data_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "oos"
      ],
      "properties": {
        "validation": {
          "const": false
        },
        "oos": {
          "const": false
        }
      }
    },
    "financial_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spend_money",
        "purchase_data_or_services",
        "place_live_trade",
        "transfer_or_withdraw_funds"
      ],
      "properties": {
        "spend_money": {
          "const": false
        },
        "purchase_data_or_services": {
          "const": false
        },
        "place_live_trade": {
          "const": false
        },
        "transfer_or_withdraw_funds": {
          "const": false
        }
      }
    },
    "merge_to_default_branch_permitted": {
      "const": false
    },
    "authorization_basis": {
      "type": "string",
      "minLength": 1
    }
  }
}
