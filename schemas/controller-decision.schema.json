{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/williammolina489/passive-income-orchestrator/blob/main/schemas/controller-decision.schema.json",
  "title": "Passive Income Orchestrator Controller Decision",
  "description": "One bounded scheduling decision. candidate_id is narrowed dynamically to the verified candidates plus NONE before each API request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "candidate_id",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision": {
      "enum": [
        "RUN_TASK",
        "WAIT",
        "BLOCKED",
        "STOP",
        "NEEDS_HUMAN"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
